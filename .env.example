# =============================================================
# DeAIPro — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================

# --- MongoDB (local Docker — no changes needed for local dev) ---
MONGODB_USER=root
MONGODB_PASSWORD=deaipro_local
MONGODB_PORT=27017

# --- App Environment ---
ENVIRONMENT=development

# --- Backend Port ---
BACKEND_PORT=8000

# --- Frontend Port ---
FRONTEND_PORT=3000

# --- CORS (leave as-is for local dev) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- TaoStats API (get from https://taostats.io/api)
# Leave blank to skip subnet data sync — app will start but show empty subnet list
TAOSTATS_API_KEY=

# --- Firebase Authentication (get from Firebase Console > Project Settings > Service Accounts)
# Leave blank to run in anonymous/dev mode — auth endpoints will not work
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# --- Sentry Error Tracking (optional — get from sentry.io)
# Leave blank to disable error tracking
SENTRY_DSN_BACKEND=
VITE_SENTRY_DSN=

# --- External API URLs (defaults are fine, do not change unless needed) ---
TAOSTATS_API_URL=https://api.taostats.io
TAOMARKETCAP_API_URL=https://api.taomarketcap.com
